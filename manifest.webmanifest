{
 "name": "DietDesk",
 "short_name": "DietDesk",
 "description": "Piani dietetici in mobilit\u00e0",
 "lang": "it",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "orientation": "portrait",
 "background_color": "#F3F6F4",
 "theme_color": "#1F5A45",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "icon-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "file_handlers": [
  {
   "action": "./",
   "accept": {
    "application/octet-stream": [
     ".ppd",
     ".cpd",
     ".ndiet",
     ".xlsx"
    ]
   }
  }
 ]
}